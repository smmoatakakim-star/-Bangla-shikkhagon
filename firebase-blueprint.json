{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student, Teacher, or Admin user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "classGrade": { "type": "string", "maxLength": 20 },
        "bio": { "type": "string", "maxLength": 500 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "totalPosts": { "type": "number" },
        "totalLikesReceived": { "type": "number" },
        "savedPostIds": { "type": "array" },
        "savedLessonIds": { "type": "array" },
        "savedQuizIds": { "type": "array" },
        "completedChapterIds": { "type": "array" },
        "bookmarkedQuestionIds": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "isBanned": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Post": {
      "title": "Post",
      "description": "Educational community post shared by students or teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "authorRole": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "authorClass": { "type": "string", "maxLength": 50 },
        "text": { "type": "string", "maxLength": 3000 },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "videoUrl": { "type": "string", "maxLength": 2000 },
        "videoThumbnail": { "type": "string", "maxLength": 2000 },
        "mediaType": { "type": "string", "enum": ["image", "video", "text"] },
        "subjectId": { "type": "string", "maxLength": 50 },
        "subjectName": { "type": "string", "maxLength": 50 },
        "classId": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "likes": { "type": "number" },
        "likedByUserIds": { "type": "array" },
        "commentCount": { "type": "number" },
        "savedByUserIds": { "type": "array" },
        "isPinned": { "type": "boolean" }
      },
      "required": ["id", "authorId", "authorName", "text", "subjectId", "classId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment and discussion under a community post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "authorClass": { "type": "string", "maxLength": 50 },
        "authorRole": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "content": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "likes": { "type": "number" },
        "likedByUserIds": { "type": "array" },
        "replies": { "type": "array" }
      },
      "required": ["id", "postId", "authorId", "authorName", "content"]
    },
    "Report": {
      "title": "Report",
      "description": "Content moderation report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["post", "comment", "user"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetPreview": { "type": "string", "maxLength": 500 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "maxLength": 100 },
        "reason": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "targetType", "targetId", "reporterId", "reason", "status"]
    },
    "ManagedClass": {
      "title": "ManagedClass",
      "description": "Educational class or academic grade level",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "numericGrade": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "iconName": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "totalChapters": { "type": "number" },
        "totalQuizzes": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "numericGrade", "status"]
    },
    "ManagedSubject": {
      "title": "ManagedSubject",
      "description": "Curriculum subject belonging to a class",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "banglaName": { "type": "string", "maxLength": 100 },
        "classId": { "type": "string", "maxLength": 64 },
        "iconName": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "classId", "status"]
    },
    "ManagedChapter": {
      "title": "ManagedChapter",
      "description": "Syllabus chapter under a specific subject and class",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "chapterNumber": { "type": "number" },
        "description": { "type": "string", "maxLength": 1000 },
        "isPopular": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "classId", "subjectId", "title", "status"]
    },
    "ManagedQuestion": {
      "title": "ManagedQuestion",
      "description": "Educational MCQ or CQ question with explanations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "chapterId": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "maxLength": 2000 },
        "options": { "type": "array" },
        "correctAnswerIndex": { "type": "number" },
        "explanation": { "type": "string", "maxLength": 3000 },
        "source": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["mcq", "cq"] },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "classId", "subjectId", "question", "status"]
    },
    "ManagedNote": {
      "title": "ManagedNote",
      "description": "Educational study note, revision guide, or lesson",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "chapterId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "explanation": { "type": "string", "maxLength": 5000 },
        "keyPoints": { "type": "array" },
        "quickNotes": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "classId", "subjectId", "title", "status"]
    },
    "ManagedNotice": {
      "title": "ManagedNotice",
      "description": "Site announcement, exam alert, or festive notice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "text": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["urgent", "info", "festive", "exam"] },
        "showOnBanner": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "text", "status"]
    },
    "SiteSeo": {
      "title": "SiteSeo",
      "description": "SEO titles, meta descriptions, and OpenGraph tags",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "siteTitle": { "type": "string", "maxLength": 200 },
        "metaDescription": { "type": "string", "maxLength": 500 },
        "keywords": { "type": "string", "maxLength": 500 },
        "ogTitle": { "type": "string", "maxLength": 200 },
        "ogDescription": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "siteTitle", "metaDescription"]
    },
    "AdminDraft": {
      "title": "AdminDraft",
      "description": "Staging area for AI generated drafts awaiting admin approval",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["mcq", "lesson", "chapter", "notice"] },
        "topic": { "type": "string", "maxLength": 200 },
        "targetClass": { "type": "string", "maxLength": 64 },
        "targetSubject": { "type": "string", "maxLength": 64 },
        "content": { "type": "string", "maxLength": 10000 },
        "status": { "type": "string", "enum": ["draft", "published", "discarded"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "type", "topic", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Community posts and educational questions"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on community posts"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User moderation reports for inappropriate content"
    },
    "/admins/{adminId}": {
      "schema": "User",
      "description": "Designated administrator records"
    },
    "/content_classes/{classId}": {
      "schema": "ManagedClass",
      "description": "Managed educational classes and grades"
    },
    "/content_subjects/{subjectId}": {
      "schema": "ManagedSubject",
      "description": "Managed curriculum subjects"
    },
    "/content_chapters/{chapterId}": {
      "schema": "ManagedChapter",
      "description": "Managed curriculum chapters"
    },
    "/content_questions/{questionId}": {
      "schema": "ManagedQuestion",
      "description": "Managed questions and MCQs"
    },
    "/content_notes/{noteId}": {
      "schema": "ManagedNote",
      "description": "Managed educational lesson notes and study materials"
    },
    "/content_notices/{noticeId}": {
      "schema": "ManagedNotice",
      "description": "Managed site notices and announcement banners"
    },
    "/site_config/{configId}": {
      "schema": "SiteSeo",
      "description": "SEO titles, meta tags, and site configuration"
    },
    "/admin_drafts/{draftId}": {
      "schema": "AdminDraft",
      "description": "AI-generated drafts awaiting admin review and publishing"
    }
  }
}
