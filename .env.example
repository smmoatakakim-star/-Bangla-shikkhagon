# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_API_URL / VITE_CLOUD_RUN_URL:
# The URL where the backend server is hosted (Cloud Run service URL).
# When deploying frontend to Firebase Hosting, set VITE_CLOUD_RUN_URL to your Cloud Run URL
# so the live web frontend connects securely to your server AI endpoints.
APP_URL="MY_APP_URL"
VITE_CLOUD_RUN_URL="https://ais-dev-a6auf64pabvjfik7xig7am-120141239167.asia-southeast1.run.app"
VITE_API_URL=""

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: GitHub OAuth App credentials.
# Created at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google reCAPTCHA Enterprise (Score-based / v3)
# Public Client-side Site Key (safe for frontend)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# Server-side assessment credentials (NEVER expose to client code)
RECAPTCHA_ENTERPRISE_API_KEY=""
RECAPTCHA_ENTERPRISE_PROJECT_ID="gen-lang-client-0028107936"
